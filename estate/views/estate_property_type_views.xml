<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record id="action_estate_property_type" model="ir.actions.act_window">
            <field name="name">نوع ملک</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="estate_property_type_view_form" model="ir.ui.view">
            <field name="name">estate.property.type.form</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <form>

                    <button class="oe_stat_button" type="action"
                        name="%(action_estate_property_offer)d"
                        context="{'search_default_property_type_id': active_id}"
                        icon="fa-money">

                        <field name="offer_count" widget="statinfo" string="پیشنهاد ها" />
                    </button>


                    <h1>
                        <field name="name" />
                    </h1>

                    <notebook>
                        <page string="املاک مرتبط">
                            <field name="property_ids">
                                <tree>
                                    <field name="name" width="10" />
                                    <field name="expected_price" width="10" />
                                    <field name="state" width="10" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="view_estate_property_type_tree" model="ir.ui.view">
            <field name="name">estate.property.type.tree</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="offer_count" />
                </tree>
            </field>
        </record>



        <record id="view_estate_property_type_search" model="ir.ui.view">
            <field name="name">estate.property.type.search</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                </search>
            </field>
        </record>

    </data>
</odoo>